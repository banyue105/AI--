# Copy to .env; replace these local development placeholders.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=ican_assistant
DB_USERNAME=ican
DB_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-root-local-only
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8000
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000
AI_FALLBACK_TO_MOCK=true
AI_DISABLE_THINKING=false
